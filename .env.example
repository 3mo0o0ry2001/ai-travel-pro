APP_ENV=development
# demo is explicit and is never permitted in production.
FLIGHT_PROVIDER=demo
BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=data/travel.db
APP_SECRET=
SERP_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DAILY_PROVIDER_LIMIT=500
ALERT_INTERVAL_SECONDS=43200
# Without SMTP in development, mail is saved to data/dev-mail.jsonl.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
