      "Bash(npm publish*)",
      "Bash(cargo publish*)",
      "Bash(twine upload*)",
      "Bash(kubectl delete*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(claude * --dangerously-skip-permissions*)",
      "Bash(powershell -EncodedCommand*)",
      "Bash(* | sh)",
      "Bash(* | bash)",
      "Bash(* | iex)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
